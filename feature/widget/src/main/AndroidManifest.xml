<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>
        <receiver
            android:name=".StatusWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_status_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_status" />
        </receiver>

        <receiver
            android:name=".DownloadsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_downloads_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_downloads" />
        </receiver>

        <service
            android:name=".NasTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_nas"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".DownloadProgressService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
